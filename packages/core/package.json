{
  "name": "@rundown/core",
  "version": "0.1.0",
  "description": "Rundown SDK: activity sources, agent adapters, briefs and summarizer as Effect services",
  "keywords": [
    "cli",
    "developer-tools",
    "effect",
    "productivity",
    "standup"
  ],
  "homepage": "https://github.com/itamarhanan/rundown#readme",
  "bugs": {
    "url": "https://github.com/itamarhanan/rundown/issues"
  },
  "license": "MIT",
  "author": "Itamar Hanan <itamarhanan@hilma.tech>",
  "repository": {
    "type": "git",
    "url": "https://github.com/itamarhanan/rundown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@rundown/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/groq": "^4.0.70",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@effect/platform": "^0.97.3",
    "ai": "^7.0.153",
    "better-sqlite3": "^13.0.3",
    "effect": "^3.22.4",
    "yaml": "^2.9.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
